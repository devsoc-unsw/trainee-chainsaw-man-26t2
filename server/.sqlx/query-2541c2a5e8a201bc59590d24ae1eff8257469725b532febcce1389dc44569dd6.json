{
  "db_name": "PostgreSQL",
  "query": "\n    SELECT\n        c.candidate_id,\n        c.first_name,\n        c.last_name,\n        c.email,\n        c.manifesto,\n        COALESCE(array_agg(cr.role_id) FILTER (WHERE cr.role_id IS NOT NULL), '{}') AS \"role_ids!: Vec<i64>\"\n    FROM \"candidates\" c\n    LEFT JOIN \"candidate_roles\" cr ON cr.candidate_id = c.candidate_id\n    WHERE c.campaign_id = $1\n    GROUP BY c.candidate_id\n    ",
